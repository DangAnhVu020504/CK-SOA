# Database URLs cho từng service
PRODUCT_DB_URL=mysql+pymysql://root:02052004@localhost:3306/product_db
INVENTORY_DB_URL=mysql+pymysql://root:02052004@localhost:3306/inventory_db
SALES_DB_URL=mysql+pymysql://root:02052004@localhost:3306/sales_db
SUPPLIER_DB_URL=mysql+pymysql://root:02052004@localhost:3306/supplier_db
CUSTOMER_DB_URL=mysql+pymysql://root:02052004@localhost:3306/customer_db
EMPLOYEE_DB_URL=mysql+pymysql://root:02052004@localhost:3306/employee_db
